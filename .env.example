# CallLedger local env — copy to `.env` and fill from YOUR Supabase project.
# Source of truth: this repo + your Supabase (e.g. ojznlaarxestwwpredve). Lovable Cloud is optional/legacy only.
# Never commit `.env`. Values below are placeholders only.

# --- Required for Auth / DB (Supabase) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_or_publishable_key
SUPABASE_PROJECT_ID=your_project_ref
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_optional_server
# Personal access token (Account → Access Tokens) — enables: npm run db:migrate
SUPABASE_ACCESS_TOKEN=

# Vite client mirrors (same values as above for browser bundle)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_or_publishable_key
VITE_SUPABASE_PROJECT_ID=your_project_ref

# App URL used by Stripe checkout redirects, etc.
APP_URL=http://localhost:8080
VITE_APP_URL=http://localhost:8080

# --- Optional integrations (app degrades gracefully if missing) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Twilio Verify (phone OTP) — Twilio Console → Verify → Services → Service SID
TWILIO_VERIFY_SERVICE_SID=
RESEND_API_KEY=
# Optional — only if you use Lovable AI gateway helpers; otherwise leave empty
LOVABLE_API_KEY=

# --- Production deploy (Cloudflare Workers) ---
# 1) npm run build   → Nitro writes .output/ (+ wrangler.json)
# 2) Set Workers secrets to match this file; APP_URL / VITE_APP_URL = live origin
# 3) After YOU approve: npm run deploy:cf   (or: npx wrangler deploy)
# See LOCAL-DEV.md "Ship without Lovable" and wrangler.toml stub.
# Stripe webhook: {APP_URL}/api/public/stripe-webhook
