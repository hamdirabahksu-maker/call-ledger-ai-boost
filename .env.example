# CallLedger environment template. Place real values only in a local .env or secret manager.
# Use placeholders here; never commit live credentials.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_PROJECT_ID=YOUR_PROJECT_REF
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_REF

APP_URL=http://localhost:8080
VITE_APP_URL=http://localhost:8080

# Optional provider integrations. Leave unset until configured.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
DEMO_NOTIFICATION_EMAIL=
LOVABLE_API_KEY=

